# ExceptionOps AI — direct Windows development configuration.
# Copy to .env and replace all placeholder credentials locally.
APP_NAME=ExceptionOps AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# For direct Windows runs, the Compose database is published on localhost:5433.
DATABASE_URL=postgresql+psycopg://exceptionops:replace_with_a_local_password@localhost:5433/exceptionops
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Direct Windows document storage; keep documents outside the repository.
MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENT_STORAGE_DIR=C:/ExceptionOpsData/documents

# Generate a unique secret of at least 32 characters; required for Compose.
AUTH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
EXPOSE_API_DOCS=true

# Local Compose settings. Generate a URL-safe password; do not commit .env.
POSTGRES_PASSWORD=
LOCAL_DOCUMENT_DIR=C:/ExceptionOpsData/documents
API_PORT=8000

# Extraction provider settings retained for local experiments.
EXTRACTION_PROVIDER=mock
EXTRACTION_MODEL=mock-invoice-extractor
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
EXTRACTION_TIMEOUT_SECONDS=60
MAX_EXTRACTION_TEXT_CHARS=100000
MAX_PDF_PAGES=100
# Data retention.
# 0 = no age-based document eligibility configured.
# Document content can still be purged explicitly by an administrator.
DOCUMENT_CONTENT_RETENTION_DAYS=0

# 0 = retain audit events indefinitely.
# Positive values are review thresholds only; no automatic deletion occurs.
AUDIT_EVENT_RETENTION_DAYS=0