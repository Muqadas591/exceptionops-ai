
APP_NAME=ExceptionOps AI
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+psycopg://exceptionops:change_me_local_only@localhost:5432/exceptionops

MAX_UPLOAD_SIZE_BYTES=10485760
DOCUMENT_STORAGE_DIR=.local_storage/documents

# Phase 3: use mock for local development and tests.
EXTRACTION_PROVIDER=mock
EXTRACTION_MODEL=mock-invoice-extractor

# Used only by the openai_compatible provider.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
EXTRACTION_TIMEOUT_SECONDS=60
MAX_EXTRACTION_TEXT_CHARS=100000
MAX_PDF_PAGES=100
